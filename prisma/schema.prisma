// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  OPEN
  PARTIALLY_IN_TRANSIT
  IN_TRANSIT
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderHistoryEventType {
  ORDER_CREATED
  ORDER_CANCELLED
  ORDER_REACTIVATED
  STATUS_CHANGED
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OrderItemDeliveryState {
  NONE
  ARRIVED_AT_STORE
  IN_TRANSIT
  DELIVERED
}

enum SellerType {
  RETAILER
  PERSON
  PROXY
}

enum StoreStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreRemovalReason {
  DUPLICATE
  CLOSED_OR_INACTIVE
  FALSE_INFO
  ABUSE
}

enum StoreVisibility {
  PUBLIC
  PRIVATE
}

enum StorePresenceType {
  ONLINE
  PHYSICAL
}

enum StoreContactChannelType {
  INSTAGRAM
  WHATSAPP
  EMAIL
  PHONE
  WEBSITE
  FACEBOOK
  TIKTOK
  OTHER
}

enum StoreProductTypeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreReportReason {
  SPAM
  DUPLICATE
  INCORRECT_INFO
  DOES_NOT_EXIST
  INAPPROPRIATE
}

enum StoreReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum StoreChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum NotificationType {
  PAYMENT_DUE
  ARRIVAL_DUE
  ARRIVAL_OVERDUE
  STORE_REJECTED
}

enum NotificationSubjectType {
  ORDER
  DELIVERY
  STORE
}

enum ImageIntakeEntrySource {
  IN_APP
  SHARE
}

enum ImageIntakeUsageStatus {
  SUCCEEDED
  FAILED
  /// Reservation written before the provider call, carrying an estimated cost. The spend ceiling
  /// counts it so concurrent submissions cannot each read the same under-budget total and all
  /// pass; the row is updated to SUCCEEDED or FAILED with real tokens once the call settles.
  PENDING
}

model User {
  id                          String                       @id
  name                        String
  email                       String                       @unique
  emailVerified               Boolean
  /// When set, the 7-day credential verification grace window counts from this time (e.g. immediate email change). Otherwise `createdAt` is used.
  unverifiedGraceStartsAt     DateTime?
  image                       String?
  username                    String                       @unique
  usernameChangedAt           DateTime?
  preferredCountryCode        String?
  preferredCountry            Country?                     @relation(fields: [preferredCountryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  baseCurrencyCode            String?
  /// Minor units of `baseCurrencyCode`, like `Order.totalCost` and `OrderPayment.amount`.
  /// Always a whole number of major units (a DB check enforces `% 100 = 0`); the settings
  /// boundary converts what the collector types.
  budgetAmount                Int?
  budgetResetDayOfMonth       Int?
  timezone                    String?
  /// The supported app locale the collector browses with (`es` / `en`). Captured on
  /// first sign-in and kept in sync when the collector switches language. Null until
  /// captured, in which case the default locale applies.
  locale                      String?
  /// Per-user override of the monthly AI-photo bag, set by an administrator from the moderation
  /// console and audited. Null means the product default applies; administrators are uncapped
  /// regardless of this column.
  aiMonthlyPhotoLimit         Int?
  /// Moderation role backing the better-auth admin plugin. Non-null with a `user` default so
  /// every account resolves to a concrete role; only the plugin's server-gated endpoint elevates it.
  role                        String                       @default("user")
  /// better-auth admin plugin ban fields. No ban surface ships in this release; the columns exist
  /// so the plugin's forward-compatible shape is present.
  banned                      Boolean?
  banReason                   String?
  banExpires                  DateTime?
  createdAt                   DateTime
  updatedAt                   DateTime
  sessions                    Session[]
  accounts                    Account[]
  createdStores               Store[]                      @relation("StoreCreator")
  approvedStores              Store[]                      @relation("StoreApprover")
  storeReviews                StoreReview[]
  storeNotes                  StoreNote[]
  storeReports                StoreReport[]
  storeProductTypeRequests    StoreProductTypeRequest[]
  storeChangeRequests         StoreChangeRequest[]
  reviewedStoreChangeRequests StoreChangeRequest[]         @relation("StoreChangeRequestReviewer")
  orders                      Order[]
  orderItems                  OrderItem[]
  orderPayments               OrderPayment[]
  storePayments               StorePayment[]
  paymentAllocations          PaymentAllocation[]
  storeAccountAdjustments     StoreAccountAdjustment[]
  storeAccountAdjustmentLines StoreAccountAdjustmentLine[]
  orderHistory                OrderHistory[]
  preferredProductTypes       UserPreferredProductType[]
  deliveries                  Delivery[]
  pushSubscriptions           PushSubscription[]
  notificationDeliveries      NotificationDelivery[]
  notificationPreference      NotificationPreference?
  adminAuditLogs              AdminAuditLog[]              @relation("AdminAuditLogActor")
  imageIntakeUsages           ImageIntakeUsage[]
  imageIntakePeriods          ImageIntakePeriod[]
  pointLedgerEntries          PointLedgerEntry[]
  progress                    UserProgress?
  medalUnlocks                MedalUnlock[]
  progressionSettings         ProgressionSettings?

  @@index([preferredCountryCode])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  /// better-auth admin plugin: set to the acting admin's id during impersonation. No impersonation surface ships in this release.
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

/// Append-only accountability trail for privileged moderation actions. Rows are written through
/// `writeAuditEntry()` and never updated or deleted. Entries reference records by type and id and
/// store no reporter identity or report free text; `action` and `targetType` are validated in code
/// against stable constant vocabularies rather than database enums.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AdminAuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

model Country {
  code           String               @id
  stores         Store[]
  storeImports   StoreImportCountry[]
  usersPreferred User[]

  @@map("country")
}

model Store {
  id                      String                       @id @default(cuid())
  slug                    String                       @unique
  name                    String
  // Diacritic-stripped, lowercased, punctuation-collapsed copy of `name` (JS `normalizeStoreName`).
  // Lets duplicate detection pre-filter in SQL with `contains` on normalized terms instead of
  // scanning rows and scoring every name in memory. Written on every create/name edit.
  searchName              String                       @default("")
  description             String?
  logoUrl                 String?
  sellerType              SellerType
  status                  StoreStatus                  @default(PENDING)
  visibility              StoreVisibility              @default(PUBLIC)
  isActive                Boolean                      @default(true)
  isPrivate               Boolean                      @default(false)
  hasStock                Boolean?
  receivesOrders          Boolean?
  countryCode             String
  averageRating           Float?
  reviewCount             Int                          @default(0)
  createdByUserId         String
  approvedByUserId        String?
  approvedAt              DateTime?
  removalReason           StoreRemovalReason?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  country                 Country                      @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  createdByUser           User                         @relation("StoreCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUser          User?                        @relation("StoreApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  presences               StorePresence[]
  contactChannels         StoreContactChannel[]
  addresses               StoreAddress[]
  importCountries         StoreImportCountry[]
  productTypeAssignments  StoreProductTypeAssignment[]
  reviews                 StoreReview[]
  notes                   StoreNote[]
  reports                 StoreReport[]
  changeRequests          StoreChangeRequest[]
  orders                  Order[]
  deliveries              Delivery[]
  storePayments           StorePayment[]
  storeAccountAdjustments StoreAccountAdjustment[]

  @@index([countryCode])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([status])
  @@index([visibility])
  @@index([isActive])
  @@index([isPrivate])
  @@index([status, visibility, isActive])
  @@index([searchName])
  @@map("store")
}

model StorePresence {
  storeId      String
  presenceType StorePresenceType
  createdAt    DateTime          @default(now())
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, presenceType])
  @@index([presenceType])
  @@map("store_presence")
}

model StoreContactChannel {
  id              String                  @id @default(cuid())
  storeId         String
  type            StoreContactChannelType
  value           String
  label           String?
  customTypeLabel String?
  isPrimary       Boolean                 @default(false)
  isPublic        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([type])
  @@map("store_contact_channel")
}

model StoreAddress {
  id          String   @id @default(cuid())
  storeId     String
  city        String?
  district    String?
  addressLine String
  reference   String?
  isPrimary   Boolean  @default(false)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_address")
}

model StoreImportCountry {
  storeId     String
  countryCode String
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  country     Country  @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@id([storeId, countryCode])
  @@index([countryCode])
  @@map("store_import_country")
}

model StoreProductType {
  key             String                       @id
  // Admin-authored types persist their localized names here; seeded keys keep their names in the
  // `storeProductTypes` i18n namespace and a resolver prefers the DB name with an i18n fallback.
  nameEs          String?
  nameEn          String?
  isActive        Boolean                      @default(true)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  assignments     StoreProductTypeAssignment[]
  userPreferences UserPreferredProductType[]
  orderItems      OrderItem[]

  @@map("store_product_type")
}

model UserPreferredProductType {
  userId         String
  productTypeKey String
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType    StoreProductType @relation(fields: [productTypeKey], references: [key], onDelete: Restrict)

  @@id([userId, productTypeKey])
  @@index([productTypeKey])
  @@map("user_preferred_product_type")
}

model StoreProductTypeAssignment {
  storeId        String
  productTypeKey String
  createdAt      DateTime         @default(now())
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productType    StoreProductType @relation(fields: [productTypeKey], references: [key], onDelete: Restrict)

  @@id([storeId, productTypeKey])
  @@index([productTypeKey])
  @@map("store_product_type_assignment")
}

model StoreReview {
  id                        String   @id @default(cuid())
  storeId                   String
  userId                    String
  overallRating             Float
  communicationRating       Int?
  packingRating             Int?
  deliveryReliabilityRating Int?
  wouldBuyAgain             Boolean?
  comment                   String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  store                     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_review")
}

model StoreNote {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
  @@map("store_note")
}

model StoreReport {
  id           String            @id @default(cuid())
  storeId      String
  reportedById String
  reason       StoreReportReason
  details      String?
  status       StoreReportStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reportedBy   User              @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([reportedById])
  @@index([status])
  @@map("store_report")
}

model StoreProductTypeRequest {
  id            String                        @id @default(cuid())
  requestedById String
  suggestedKey  String?
  suggestedName String
  reason        String?
  status        StoreProductTypeRequestStatus @default(PENDING)
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  requestedBy   User                          @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById])
  @@index([status])
  @@map("store_product_type_request")
}

model StoreChangeRequest {
  id               String                   @id @default(cuid())
  storeId          String
  requestedById    String
  status           StoreChangeRequestStatus @default(PENDING)
  changes          Json
  comment          String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  store            Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requestedBy      User                     @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy       User?                    @relation("StoreChangeRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([requestedById])
  @@index([status])
  @@map("store_change_request")
}

model Order {
  id                          String                       @id @default(cuid())
  storeId                     String
  userId                      String
  humanReadableId             String                       @unique
  orderDate                   DateTime
  expectedDeliveryFrom        DateTime?
  expectedDeliveryTo          DateTime?
  currencyCode                String
  exchangeRate                Decimal?                     @db.Decimal(18, 8)
  // The base currency `exchangeRate` converts INTO, captured whenever a rate is written. Makes
  // "this order still needs FX reconciliation" fully derivable (currency differs from the user's
  // base AND no rate, or a rate stored against a different base), so no boolean flag has to be
  // kept in sync. See ADR 0024.
  exchangeRateBaseCode        String?
  totalCost                   Int
  // Denormalized payment cache kept transactionally in sync by the payment/total mutations.
  // Payments stay the source of truth (single-order views recompute from them); these fields
  // exist so the orders list can filter by payment state and sort by paid ratio entirely in
  // SQL, instead of fetching every order to derive the percentage in memory. `paymentPercent`
  // is the same floor(paid/total*100) value the UI shows, so filter/sort/display never diverge.
  /// DEPRECATED under store-level payments: frozen legacy cache, no longer maintained; kept for trial reversibility
  paidAmountMinor             Int                          @default(0)
  /// DEPRECATED under store-level payments: frozen legacy cache, no longer maintained; kept for trial reversibility
  paymentPercent              Int                          @default(0)
  /// Denormalized cache of the money declared against this order under store-level payments:
  /// the sum of `payment_allocation.amountMinor` for this order. Kept transactionally in sync by
  /// the payment mutations, exactly as the legacy `paidAmountMinor` cache was, so the orders list
  /// can filter and sort on declared money in SQL. Allocations remain the source of truth.
  allocatedAmountMinor        Int                          @default(0)
  note                        String?
  status                      OrderStatus                  @default(OPEN)
  cancellationReason          String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  store                       Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                       OrderItem[]
  payments                    OrderPayment[]
  paymentAllocations          PaymentAllocation[]
  storeAccountAdjustmentLines StoreAccountAdjustmentLine[]
  history                     OrderHistory[]

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@index([userId, orderDate])
  @@index([userId, status])
  @@index([userId, paymentPercent])
  @@map("order")
}

model OrderItem {
  id                 String                 @id @default(cuid())
  orderId            String
  userId             String
  name               String
  quantity           Int                    @default(1)
  unitPrice          Int?
  productTypeKey     String?
  position           Int
  deliveryState      OrderItemDeliveryState @default(NONE)
  /// The collector's own claim that this product is paid, with no amount committed. NEVER written by
  /// a derivation: only an explicit user action sets or clears it, and it moves no money figure
  /// anywhere (no allocation, no order balance, no store debt, no reminder). `null` = unmarked.
  /// An instant rather than a calendar day: "when did I mark this" is the question it answers.
  paidDeclaredAt     DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType        StoreProductType?      @relation(fields: [productTypeKey], references: [key], onDelete: Restrict)
  deliveryItems      DeliveryOrderItem[]
  paymentAllocations PaymentAllocation[]

  @@unique([orderId, position])
  @@index([orderId])
  @@index([userId])
  @@index([userId, deliveryState])
  @@map("order_item")
}

model OrderPayment {
  id          String   @id @default(cuid())
  orderId     String
  userId      String
  amount      Int
  paymentDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@map("order_payment")
}

/// A payment the collector made to a store. Money is tracked at the store level because that is
/// how it actually leaves the collector's hands: one transfer often covers several orders, and
/// which orders it covers is a separate, optional declaration (`PaymentAllocation`). The FX shape
/// mirrors `Order` so a payment can be reconciled against the user's base currency on its own.
/// `userId` is duplicated here (see data-layer-user-id-duplication.mdc) so payments can be listed
/// and authorized per user without joining back through `Store`.
model StorePayment {
  id                   String              @id @default(cuid())
  storeId              String
  userId               String
  /// Minor units of `currencyCode`: cash that left the collector's hands. Always > 0.
  amount               Int
  paymentDate          DateTime
  currencyCode         String
  exchangeRate         Decimal?            @db.Decimal(18, 8)
  /// The base currency `exchangeRate` converts INTO. Mirrors `Order.exchangeRateBaseCode`; see ADR 0024.
  exchangeRateBaseCode String?
  note                 String?
  /// Provenance of the one-to-one backfill from `order_payment` only, never read by business
  /// logic. Null on every payment recorded through the app.
  migratedFromOrderId  String?
  /// The delivery whose arrival settled this payment (ADR 0032). Null for a payment recorded
  /// outside that flow. Restrict on delete: a delivery that settled a payment cannot be removed
  /// without first reassigning or deleting the payment it produced.
  settledByDeliveryId  String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  store                Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  settledByDelivery    Delivery?           @relation(fields: [settledByDeliveryId], references: [id], onDelete: Restrict)
  allocations          PaymentAllocation[]

  @@index([storeId])
  @@index([userId])
  @@index([userId, paymentDate])
  @@index([userId, storeId, currencyCode])
  @@index([settledByDeliveryId])
  @@map("store_payment")
}

/// The collector's declaration of what a store payment was for. Always names an order, and
/// optionally narrows to a single item of that order. Declaring is opt-in: a payment can sit
/// unallocated, and an order can be declared settled without a known price, which is why
/// `settlesTarget` exists alongside `amountMinor`.
/// `userId` is duplicated here (see data-layer-user-id-duplication.mdc) so an allocation can be
/// authorized and queried directly, without joining back to `StorePayment` or `Order`.
model PaymentAllocation {
  id                   String       @id @default(cuid())
  paymentId            String
  orderId              String
  orderItemId          String?
  userId               String
  /// Minor units of the parent payment's currency, always >= 0. Zero is only meaningful together
  /// with `settlesTarget`, which declares the target covered without naming an amount.
  amountMinor          Int          @default(0)
  /// DEPRECATED, read-tolerant / write-strict. "Settled in full" declaration, without an amount.
  /// No writer has existed since the `20260808215744` migration backfilled every legacy row to
  /// `false`, and `createStorePayment` now refuses `true` outright: an amount-less declaration is
  /// `OrderItem.paidDeclaredAt`, which is editable and does not leave a phantom 0.00 row in an
  /// order's payment history. Reads still honor a `true` row so one arriving out of band renders as
  /// "Saldado" rather than as that phantom.
  settlesTarget        Boolean      @default(false)
  /// Provenance for a `consumeUnassignedStoreMoneyOnOrderClose` (`WO-09`, `ADR 0033 §4`) write: the
  /// delivery whose arrival closed the order and triggered this consumption. Null for every other
  /// allocation (a collector's own declared payment, or a settlement StorePayment's own allocation,
  /// which already carries its provenance on `StorePayment.settledByDeliveryId` instead). `SetNull`
  /// on delete: this row represents money paid to the store BEFORE the delivery ever existed, so
  /// deleting the delivery must neither cascade into it nor be blocked by it (`WO-08` UX Notes,
  /// "known gap" closure) — only the provenance link is cleared, the allocation itself survives.
  consumedByDeliveryId String?
  createdAt            DateTime     @default(now())
  payment              StorePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order                Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem            OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumedByDelivery   Delivery?    @relation(fields: [consumedByDeliveryId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([userId])
  @@index([consumedByDeliveryId])
  @@map("payment_allocation")
}

/// A collector's declaration that a store's account is squared beyond what the app can otherwise
/// see (`ADR 0034`). Carries one line per order it writes off (`StoreAccountAdjustmentLine`); it
/// is never a `StorePayment` and its lines are never `PaymentAllocation` rows, because an
/// adjustment must stay outside every allocation-based figure (`BR-06-04`). Stores no total: the
/// magnitude is the sum of its own lines, derived at read time so an order-deletion cascade can
/// never leave a stale header behind it (`ADR 0034` §5).
model StoreAccountAdjustment {
  id             String                       @id @default(cuid())
  storeId        String
  userId         String
  currencyCode   String
  adjustmentDate DateTime
  reason         String
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  store          Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines          StoreAccountAdjustmentLine[]

  @@index([userId])
  @@index([storeId])
  @@index([userId, storeId, currencyCode])
  @@index([userId, adjustmentDate])
  @@map("store_account_adjustment")
}

/// What one `StoreAccountAdjustment` writes off, on one order. `amountMinor` is always > 0
/// (enforced by a hand-written `CHECK` in the migration; Prisma cannot express one) and never
/// greater than that order's own `openBalanceMinor` at write time, which is enforced by the
/// mutation, not the schema. Never related to `PaymentAllocation`: a line records that a balance
/// was written off, not that money arrived. `userId` is duplicated here (see
/// data-layer-user-id-duplication.mdc) so the debt figures can read lines by order without
/// joining back through the adjustment header.
model StoreAccountAdjustmentLine {
  id           String                 @id @default(cuid())
  adjustmentId String
  orderId      String
  userId       String
  amountMinor  Int
  createdAt    DateTime               @default(now())
  adjustment   StoreAccountAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([adjustmentId, orderId])
  @@index([userId, orderId])
  @@index([adjustmentId])
  @@map("store_account_adjustment_line")
}

model OrderHistory {
  id        String                @id @default(cuid())
  orderId   String
  userId    String
  eventType OrderHistoryEventType
  metadata  Json                  @default("{}")
  createdAt DateTime              @default(now())
  order     Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_history")
}

model Delivery {
  id                   String              @id @default(cuid())
  humanReadableId      String              @unique
  storeId              String
  userId               String
  status               DeliveryStatus      @default(IN_TRANSIT)
  deliveryDate         DateTime
  expectedArrivalFrom  DateTime?
  expectedArrivalTo    DateTime?
  receivedDate         DateTime?
  cost                 Int
  currencyCode         String
  exchangeRate         Decimal?            @db.Decimal(18, 8)
  /// The base currency `exchangeRate` converts INTO. Mirrors `Order.exchangeRateBaseCode`; see ADR 0024.
  exchangeRateBaseCode String?
  note                 String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  store                Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems           DeliveryOrderItem[]
  settlementPayments   StorePayment[]
  /// Inverse of `PaymentAllocation.consumedByDeliveryId`: allocations whose close-time consumption
  /// (`FR-08-46`) this delivery triggered. Not deleted or touched when the delivery is reopened or
  /// removed (`onDelete: SetNull` on the child field) — that money stays applied to its order.
  consumedAllocations  PaymentAllocation[]

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@index([userId, deliveryDate])
  @@map("delivery")
}

model DeliveryOrderItem {
  deliveryId  String
  orderItemId String
  createdAt   DateTime  @default(now())
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@id([deliveryId, orderItemId])
  @@index([orderItemId])
  @@map("delivery_order_item")
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

model NotificationDelivery {
  id          String                  @id @default(cuid())
  userId      String
  type        NotificationType
  subjectType NotificationSubjectType
  subjectId   String
  dueDate     DateTime
  sentAt      DateTime                @default(now())
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, subjectId, dueDate])
  @@index([userId])
  @@map("notification_delivery")
}

model NotificationPreference {
  userId                String   @id
  paymentDueEnabled     Boolean  @default(true)
  arrivalDueEnabled     Boolean  @default(true)
  arrivalOverdueEnabled Boolean  @default(true)
  storeRejectedEnabled  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

/// Spend ledger for the order image intake AI extraction feature. Every row is one billable
/// extraction call against the shared, paid-tier Gemini key, successful or not: a call Google
/// answered with an unusable response still cost money and must still count. A row is inserted
/// PENDING (as a reservation, with an estimated cost) before the call and updated exactly once
/// when it settles, so the only mutation a row ever sees is that settlement. The global monthly
/// spend guard sums this table across all users because the key is shared, not per-user.
/// `userId` is duplicated here (see data-layer-user-id-duplication.mdc) so the ledger can be
/// queried and rate-limited per user without joining back to `User` on every check.
model ImageIntakeUsage {
  id           String                 @id @default(cuid())
  userId       String
  /// Billing period the row belongs to, `YYYY-MM` (UTC), matching the global monthly cut-off.
  periodKey    String
  /// Calendar day the row belongs to, `YYYY-MM-DD` (UTC). Kept alongside `periodKey` so a future
  /// daily breakdown never needs to re-derive it from `createdAt` in application code.
  dayKey       String
  entrySource  ImageIntakeEntrySource
  status       ImageIntakeUsageStatus
  imageCount   Int
  model        String
  inputTokens  Int
  outputTokens Int
  costMicroUsd Int
  /// Weak reference only: this WO-01 slice never writes an order (enforced by
  /// image-intake-no-persistence-guard.test.ts), so no relation/FK is declared here and every row
  /// is created with `orderId: null`. A later slice may backfill it once a save action exists.
  orderId      String?
  createdAt    DateTime               @default(now())
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodKey])
  @@index([userId, dayKey])
  @@index([periodKey])
  @@map("image_intake_usage")
}

/// Per-user, per-period roll-up of the monthly AI-photo bag. Derivable from `ImageIntakeUsage`,
/// but kept as its own aggregate so the quota check on the reservation path and the passive
/// counter on every create surface are one indexed read instead of a scan over the ledger.
///
/// `usedPhotos` counts photos that are reserved (PENDING) or confirmed (SUCCEEDED): a failed
/// submission gives its photos back at settlement, because a provider failure is never billed to
/// the collector. Reset is implicit through `periodKey`; no scheduled job exists.
model ImageIntakePeriod {
  id           String   @id @default(cuid())
  userId       String
  /// Billing period the roll-up belongs to, `YYYY-MM` (UTC), same key the ledger rows carry.
  periodKey    String
  usedPhotos   Int      @default(0)
  /// Running cost of this user's own submissions in the period, in micro-USD. Reserved at the
  /// estimate and corrected to the real figure at settlement.
  costMicroUsd Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@map("image_intake_period")
}

/// Provenance of a progression credit. `BACKFILL` marks a synthetic entry replayed from the
/// migrated Notion history: it counts toward the private rank exactly like a `LIVE` entry, but is
/// stored explicitly rather than inferred from a date so any future cross-user surface can exclude
/// it without re-deriving what was real activity and what was a migration.
enum PointLedgerSource {
  LIVE
  BACKFILL
}

/// Append-only progression ledger. One row per point-earning fact, idempotent on
/// `(userId, ruleKey, entityId)`. A row is never edited to correct a balance and never carries a
/// negative value: the balance the collector sees is DERIVED by recomputing which rows still refer
/// to an entity that exists and still satisfies its rule's eligibility predicate.
///
/// `entityId` deliberately carries NO foreign key. A cascade from `Order`/`Delivery` would erase
/// the very evidence the ledger exists to keep the moment the entity is hard-deleted, and would
/// reopen the create-credit-delete-recreate farming loop. See ADR 0035.
model PointLedgerEntry {
  id             String            @id @default(cuid())
  userId         String
  /// One of the rule catalogue keys in `src/lib/data/progression/pointRules.ts`.
  ruleKey        String
  /// The kind of entity `entityId` names (`order`, `delivery`, `store`, `productType`, ...).
  /// Read only to pick the batch eligibility resolver; it is not a validated reference.
  entityType     String
  /// Plain string, no foreign key, survives the referenced entity's own physical deletion.
  entityId       String
  /// Strictly positive. The ledger admits no negative entry.
  points         Int
  /// Civil day resolved on the server from the collector's timezone at the moment of crediting,
  /// pinned to UTC midnight. Never the entity's own domain date, never a wall-clock instant, and
  /// never re-bucketed by a later recompute.
  occurredOn     DateTime
  source         PointLedgerSource @default(LIVE)
  /// Wall-clock write time, deliberately distinct from `occurredOn`. Breaks cap ties.
  createdAt      DateTime          @default(now())
  /// Set by an administrative void. The recompute excludes any row carrying it, so the reversal
  /// needs neither a deletion nor a compensating negative row.
  voidedAt       DateTime?
  /// Administrator-supplied reason, always present when `voidedAt` is set.
  voidedReason   String?
  /// The acting administrator's id. Intentionally not a relation: the trail must survive that
  /// account being removed.
  voidedByUserId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleKey, entityId])
  @@index([userId])
  @@index([voidedAt])
  @@map("point_ledger_entry")
}

/// Rebuildable cache of the derived progression figures, never a source of truth. Dropping every
/// row here loses nothing: the next recompute rebuilds them from the ledger.
model UserProgress {
  userId           String   @id
  /// Derived total after eligibility filtering and cap enforcement.
  maturedPoints    Int      @default(0)
  /// Rank derived from `maturedPoints` right now; may move down when entries stop counting.
  rankIndex        Int      @default(1)
  /// Running maximum. Never decreases: the title once reached is permanent.
  highestRankIndex Int      @default(1)
  /// Drives the staleness check that decides whether opening the section triggers a recompute.
  lastRecomputedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

/// One row per medal a collector has unlocked. Unlocks are permanent: there is no revocation path,
/// and a medal whose condition stops holding is labelled rather than removed.
model MedalUnlock {
  id           String            @id @default(cuid())
  userId       String
  /// One of the catalogue keys in `src/lib/data/progression/medalCatalogue.ts`.
  medalKey     String
  /// A backfilled unlock carries the backfill date, never a fabricated original one.
  unlockedAt   DateTime
  /// Null until the celebration has been shown. Backfilled rows are written pre-seen so a migrated
  /// history does not replay itself as dozens of toasts on first login.
  seenAt       DateTime?
  /// Denormalized from the catalogue for query-time grouping into album pages.
  series       String
  /// Denormalized print-run grade; the album groups and styles by it without loading the catalogue.
  numbered     Boolean           @default(false)
  rarity       String
  /// Ordinal stamped at unlock time when `numbered` is true.
  serialNumber Int?
  source       PointLedgerSource @default(LIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, medalKey])
  @@index([userId])
  @@map("medal_unlock")
}

/// Per-collector progression preferences. Kept separate from `UserProgress` because these are the
/// collector's own choices, not a derived cache, and must survive a purge of the ledger.
model ProgressionSettings {
  userId                  String  @id
  /// Hides the whole layer: navigation entry, dashboard widget, toasts and celebrations. Points
  /// keep accruing so turning it back on does not restart from zero.
  hideProgression         Boolean @default(false)
  /// Highest rank already celebrated, so the once-per-rank celebration is never replayed by a
  /// recompute that re-derives the same rank.
  lastCelebratedRankIndex Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progression_settings")
}
