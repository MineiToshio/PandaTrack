// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  OPEN
  PARTIALLY_IN_TRANSIT
  IN_TRANSIT
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderHistoryEventType {
  ORDER_CREATED
  ORDER_CANCELLED
  ORDER_REACTIVATED
  STATUS_CHANGED
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OrderItemDeliveryState {
  NONE
  ARRIVED_AT_STORE
  IN_TRANSIT
  DELIVERED
}

enum StoreType {
  BUSINESS
  PERSON
}

enum StoreStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum StoreVisibility {
  PUBLIC
  PRIVATE
}

enum StorePresenceType {
  ONLINE
  PHYSICAL
}

enum StoreContactChannelType {
  INSTAGRAM
  WHATSAPP
  EMAIL
  PHONE
  WEBSITE
  FACEBOOK
  TIKTOK
  OTHER
}

enum StoreProductTypeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreReportReason {
  SPAM
  DUPLICATE
  INCORRECT_INFO
  DOES_NOT_EXIST
  INAPPROPRIATE
}

enum StoreReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum StoreChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                          String                 @id
  name                        String
  email                       String                 @unique
  emailVerified               Boolean
  /// When set, the 7-day credential verification grace window counts from this time (e.g. immediate email change). Otherwise `createdAt` is used.
  unverifiedGraceStartsAt     DateTime?
  image                       String?
  username                    String                 @unique
  usernameChangedAt           DateTime?
  preferredCountryCode        String?
  preferredCountry            Country?               @relation(fields: [preferredCountryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  baseCurrencyCode            String?
  budgetAmount                Int?
  budgetResetDayOfMonth       Int?
  timezone                    String?
  createdAt                   DateTime
  updatedAt                   DateTime
  sessions                    Session[]
  accounts                    Account[]
  createdStores               Store[]                @relation("StoreCreator")
  approvedStores              Store[]                @relation("StoreApprover")
  storeReviews                StoreReview[]
  storeNotes                  StoreNote[]
  storeReports                StoreReport[]
  storeProductTypeRequests    StoreProductTypeRequest[]
  storeChangeRequests         StoreChangeRequest[]
  reviewedStoreChangeRequests StoreChangeRequest[]   @relation("StoreChangeRequestReviewer")
  orders                      Order[]
  orderItems                  OrderItem[]
  orderPayments               OrderPayment[]
  orderHistory                OrderHistory[]
  preferredProductTypes       UserPreferredProductType[]
  deliveries                  Delivery[]

  @@index([preferredCountryCode])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Country {
  code           String               @id
  stores         Store[]
  storeImports   StoreImportCountry[]
  usersPreferred User[]

  @@map("country")
}

model Store {
  id                  String                    @id @default(cuid())
  slug                String                    @unique
  name                String
  description         String?
  logoUrl             String?
  storeType           StoreType
  status              StoreStatus               @default(PENDING)
  visibility          StoreVisibility           @default(PUBLIC)
  isActive            Boolean                   @default(true)
  isPrivate           Boolean                   @default(false)
  hasStock            Boolean?
  receivesOrders      Boolean?
  countryCode         String
  averageRating       Float?
  reviewCount         Int                       @default(0)
  createdByUserId     String
  approvedByUserId    String?
  approvedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  country             Country                   @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  createdByUser       User                      @relation("StoreCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUser      User?                     @relation("StoreApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  presences           StorePresence[]
  contactChannels     StoreContactChannel[]
  addresses           StoreAddress[]
  importCountries     StoreImportCountry[]
  productTypeAssignments StoreProductTypeAssignment[]
  reviews             StoreReview[]
  notes               StoreNote[]
  reports             StoreReport[]
  changeRequests      StoreChangeRequest[]
  orders              Order[]
  deliveries          Delivery[]

  @@index([countryCode])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([status])
  @@index([visibility])
  @@index([isActive])
  @@index([isPrivate])
  @@index([status, visibility, isActive])
  @@map("store")
}

model StorePresence {
  storeId      String
  presenceType StorePresenceType
  createdAt    DateTime          @default(now())
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, presenceType])
  @@index([presenceType])
  @@map("store_presence")
}

model StoreContactChannel {
  id              String                  @id @default(cuid())
  storeId         String
  type            StoreContactChannelType
  value           String
  label           String?
  customTypeLabel String?
  isPrimary       Boolean                 @default(false)
  isPublic        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([type])
  @@map("store_contact_channel")
}

model StoreAddress {
  id          String   @id @default(cuid())
  storeId     String
  city        String?
  district    String?
  addressLine String
  reference   String?
  isPrimary   Boolean  @default(false)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_address")
}

model StoreImportCountry {
  storeId     String
  countryCode String
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  country     Country  @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@id([storeId, countryCode])
  @@index([countryCode])
  @@map("store_import_country")
}

model StoreProductType {
  key         String                    @id
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  assignments StoreProductTypeAssignment[]
  userPreferences UserPreferredProductType[]
  orderItems  OrderItem[]

  @@map("store_product_type")
}

model UserPreferredProductType {
  userId           String
  productTypeKey   String
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType      StoreProductType @relation(fields: [productTypeKey], references: [key], onDelete: Restrict)

  @@id([userId, productTypeKey])
  @@index([productTypeKey])
  @@map("user_preferred_product_type")
}

model StoreProductTypeAssignment {
  storeId        String
  productTypeKey String
  createdAt      DateTime         @default(now())
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productType    StoreProductType @relation(fields: [productTypeKey], references: [key], onDelete: Restrict)

  @@id([storeId, productTypeKey])
  @@index([productTypeKey])
  @@map("store_product_type_assignment")
}

model StoreReview {
  id                        String   @id @default(cuid())
  storeId                   String
  userId                    String
  overallRating             Float
  communicationRating       Int?
  packingRating             Int?
  deliveryReliabilityRating Int?
  wouldBuyAgain             Boolean?
  comment                   String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  store                     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_review")
}

model StoreNote {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
  @@map("store_note")
}

model StoreReport {
  id           String            @id @default(cuid())
  storeId      String
  reportedById String
  reason       StoreReportReason
  details      String?
  status       StoreReportStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reportedBy   User              @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([reportedById])
  @@index([status])
  @@map("store_report")
}

model StoreProductTypeRequest {
  id            String                     @id @default(cuid())
  requestedById String
  suggestedKey  String?
  suggestedName String
  reason        String?
  status        StoreProductTypeRequestStatus @default(PENDING)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  requestedBy   User                       @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById])
  @@index([status])
  @@map("store_product_type_request")
}

model StoreChangeRequest {
  id               String                   @id @default(cuid())
  storeId          String
  requestedById    String
  status           StoreChangeRequestStatus @default(PENDING)
  changes          Json
  comment          String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  store            Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requestedBy      User                     @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy       User?                    @relation("StoreChangeRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([requestedById])
  @@index([status])
  @@map("store_change_request")
}

model Order {
  id                   String                @id @default(cuid())
  storeId              String
  userId               String
  humanReadableId      String                @unique
  orderDate            DateTime
  expectedDeliveryFrom DateTime?
  expectedDeliveryTo   DateTime?
  currencyCode         String
  exchangeRate         Decimal?
  totalCost            Int
  note                 String?
  status               OrderStatus           @default(OPEN)
  cancellationReason   String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                OrderItem[]
  payments             OrderPayment[]
  history              OrderHistory[]

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@map("order")
}

model OrderItem {
  id                String                 @id @default(cuid())
  orderId           String
  userId            String
  name              String
  quantity          Int                    @default(1)
  unitPrice         Int?
  productTypeKey    String?
  position          Int
  deliveryState     OrderItemDeliveryState @default(NONE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType       StoreProductType?      @relation(fields: [productTypeKey], references: [key], onDelete: Restrict)
  deliveryItems     DeliveryOrderItem[]

  @@index([orderId])
  @@index([userId])
  @@map("order_item")
}

model OrderPayment {
  id          String   @id @default(cuid())
  orderId     String
  userId      String
  amount      Int
  paymentDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@map("order_payment")
}

model OrderHistory {
  id        String                @id @default(cuid())
  orderId   String
  userId    String
  eventType OrderHistoryEventType
  metadata  Json                  @default("{}")
  createdAt DateTime              @default(now())
  order     Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_history")
}

model Delivery {
  id                  String              @id @default(cuid())
  humanReadableId     String              @unique
  storeId             String
  userId              String
  status              DeliveryStatus      @default(IN_TRANSIT)
  deliveryDate        DateTime
  expectedArrivalFrom DateTime?
  expectedArrivalTo   DateTime?
  receivedDate        DateTime?
  cost                Int
  currencyCode        String
  exchangeRate        Decimal?
  note                String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  store               Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems          DeliveryOrderItem[]

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@map("delivery")
}

model DeliveryOrderItem {
  deliveryId  String
  orderItemId String
  createdAt   DateTime  @default(now())
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@id([deliveryId, orderItemId])
  @@index([orderItemId])
  @@map("delivery_order_item")
}
