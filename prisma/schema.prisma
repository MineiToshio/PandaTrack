// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  OPEN
  PARTIALLY_IN_TRANSIT
  IN_TRANSIT
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderHistoryEventType {
  ORDER_CREATED
  ORDER_CANCELLED
  ORDER_REACTIVATED
  STATUS_CHANGED
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OrderItemDeliveryState {
  NONE
  ARRIVED_AT_STORE
  IN_TRANSIT
  DELIVERED
}

enum SellerType {
  RETAILER
  PERSON
  PROXY
}

enum StoreStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreRemovalReason {
  DUPLICATE
  CLOSED_OR_INACTIVE
  FALSE_INFO
  ABUSE
}

enum StoreVisibility {
  PUBLIC
  PRIVATE
}

enum StorePresenceType {
  ONLINE
  PHYSICAL
}

enum StoreContactChannelType {
  INSTAGRAM
  WHATSAPP
  EMAIL
  PHONE
  WEBSITE
  FACEBOOK
  TIKTOK
  OTHER
}

enum StoreProductTypeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreReportReason {
  SPAM
  DUPLICATE
  INCORRECT_INFO
  DOES_NOT_EXIST
  INAPPROPRIATE
}

enum StoreReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum StoreChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum NotificationType {
  PAYMENT_DUE
  ARRIVAL_DUE
  ARRIVAL_OVERDUE
  STORE_REJECTED
}

enum NotificationSubjectType {
  ORDER
  DELIVERY
  STORE
}

model User {
  id                          String                 @id
  name                        String
  email                       String                 @unique
  emailVerified               Boolean
  /// When set, the 7-day credential verification grace window counts from this time (e.g. immediate email change). Otherwise `createdAt` is used.
  unverifiedGraceStartsAt     DateTime?
  image                       String?
  username                    String                 @unique
  usernameChangedAt           DateTime?
  preferredCountryCode        String?
  preferredCountry            Country?               @relation(fields: [preferredCountryCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  baseCurrencyCode            String?
  /// Minor units of `baseCurrencyCode`, like `Order.totalCost` and `OrderPayment.amount`.
  /// Always a whole number of major units (a DB check enforces `% 100 = 0`); the settings
  /// boundary converts what the collector types.
  budgetAmount                Int?
  budgetResetDayOfMonth       Int?
  timezone                    String?
  /// The supported app locale the collector browses with (`es` / `en`). Captured on
  /// first sign-in and kept in sync when the collector switches language. Null until
  /// captured, in which case the default locale applies.
  locale                      String?
  /// Moderation role backing the better-auth admin plugin. Non-null with a `user` default so
  /// every account resolves to a concrete role; only the plugin's server-gated endpoint elevates it.
  role                        String                 @default("user")
  /// better-auth admin plugin ban fields. No ban surface ships in this release; the columns exist
  /// so the plugin's forward-compatible shape is present.
  banned                      Boolean?
  banReason                   String?
  banExpires                  DateTime?
  createdAt                   DateTime
  updatedAt                   DateTime
  sessions                    Session[]
  accounts                    Account[]
  createdStores               Store[]                @relation("StoreCreator")
  approvedStores              Store[]                @relation("StoreApprover")
  storeReviews                StoreReview[]
  storeNotes                  StoreNote[]
  storeReports                StoreReport[]
  storeProductTypeRequests    StoreProductTypeRequest[]
  storeChangeRequests         StoreChangeRequest[]
  reviewedStoreChangeRequests StoreChangeRequest[]   @relation("StoreChangeRequestReviewer")
  orders                      Order[]
  orderItems                  OrderItem[]
  orderPayments               OrderPayment[]
  orderHistory                OrderHistory[]
  preferredProductTypes       UserPreferredProductType[]
  deliveries                  Delivery[]
  pushSubscriptions           PushSubscription[]
  notificationDeliveries      NotificationDelivery[]
  notificationPreference      NotificationPreference?
  adminAuditLogs              AdminAuditLog[]        @relation("AdminAuditLogActor")

  @@index([preferredCountryCode])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  /// better-auth admin plugin: set to the acting admin's id during impersonation. No impersonation surface ships in this release.
  impersonatedBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

/// Append-only accountability trail for privileged moderation actions. Rows are written through
/// `writeAuditEntry()` and never updated or deleted. Entries reference records by type and id and
/// store no reporter identity or report free text; `action` and `targetType` are validated in code
/// against stable constant vocabularies rather than database enums.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AdminAuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

model Country {
  code           String               @id
  stores         Store[]
  storeImports   StoreImportCountry[]
  usersPreferred User[]

  @@map("country")
}

model Store {
  id                  String                    @id @default(cuid())
  slug                String                    @unique
  name                String
  // Diacritic-stripped, lowercased, punctuation-collapsed copy of `name` (JS `normalizeStoreName`).
  // Lets duplicate detection pre-filter in SQL with `contains` on normalized terms instead of
  // scanning rows and scoring every name in memory. Written on every create/name edit.
  searchName          String                    @default("")
  description         String?
  logoUrl             String?
  sellerType          SellerType
  status              StoreStatus               @default(PENDING)
  visibility          StoreVisibility           @default(PUBLIC)
  isActive            Boolean                   @default(true)
  isPrivate           Boolean                   @default(false)
  hasStock            Boolean?
  receivesOrders      Boolean?
  countryCode         String
  averageRating       Float?
  reviewCount         Int                       @default(0)
  createdByUserId     String
  approvedByUserId    String?
  approvedAt          DateTime?
  removalReason       StoreRemovalReason?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  country             Country                   @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  createdByUser       User                      @relation("StoreCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUser      User?                     @relation("StoreApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  presences           StorePresence[]
  contactChannels     StoreContactChannel[]
  addresses           StoreAddress[]
  importCountries     StoreImportCountry[]
  productTypeAssignments StoreProductTypeAssignment[]
  reviews             StoreReview[]
  notes               StoreNote[]
  reports             StoreReport[]
  changeRequests      StoreChangeRequest[]
  orders              Order[]
  deliveries          Delivery[]

  @@index([countryCode])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([status])
  @@index([visibility])
  @@index([isActive])
  @@index([isPrivate])
  @@index([status, visibility, isActive])
  @@index([searchName])
  @@map("store")
}

model StorePresence {
  storeId      String
  presenceType StorePresenceType
  createdAt    DateTime          @default(now())
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, presenceType])
  @@index([presenceType])
  @@map("store_presence")
}

model StoreContactChannel {
  id              String                  @id @default(cuid())
  storeId         String
  type            StoreContactChannelType
  value           String
  label           String?
  customTypeLabel String?
  isPrimary       Boolean                 @default(false)
  isPublic        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([type])
  @@map("store_contact_channel")
}

model StoreAddress {
  id          String   @id @default(cuid())
  storeId     String
  city        String?
  district    String?
  addressLine String
  reference   String?
  isPrimary   Boolean  @default(false)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_address")
}

model StoreImportCountry {
  storeId     String
  countryCode String
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  country     Country  @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@id([storeId, countryCode])
  @@index([countryCode])
  @@map("store_import_country")
}

model StoreProductType {
  key         String                    @id
  // Admin-authored types persist their localized names here; seeded keys keep their names in the
  // `storeProductTypes` i18n namespace and a resolver prefers the DB name with an i18n fallback.
  nameEs      String?
  nameEn      String?
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  assignments StoreProductTypeAssignment[]
  userPreferences UserPreferredProductType[]
  orderItems  OrderItem[]

  @@map("store_product_type")
}

model UserPreferredProductType {
  userId           String
  productTypeKey   String
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType      StoreProductType @relation(fields: [productTypeKey], references: [key], onDelete: Restrict)

  @@id([userId, productTypeKey])
  @@index([productTypeKey])
  @@map("user_preferred_product_type")
}

model StoreProductTypeAssignment {
  storeId        String
  productTypeKey String
  createdAt      DateTime         @default(now())
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productType    StoreProductType @relation(fields: [productTypeKey], references: [key], onDelete: Restrict)

  @@id([storeId, productTypeKey])
  @@index([productTypeKey])
  @@map("store_product_type_assignment")
}

model StoreReview {
  id                        String   @id @default(cuid())
  storeId                   String
  userId                    String
  overallRating             Float
  communicationRating       Int?
  packingRating             Int?
  deliveryReliabilityRating Int?
  wouldBuyAgain             Boolean?
  comment                   String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  store                     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_review")
}

model StoreNote {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
  @@map("store_note")
}

model StoreReport {
  id           String            @id @default(cuid())
  storeId      String
  reportedById String
  reason       StoreReportReason
  details      String?
  status       StoreReportStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reportedBy   User              @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([reportedById])
  @@index([status])
  @@map("store_report")
}

model StoreProductTypeRequest {
  id            String                     @id @default(cuid())
  requestedById String
  suggestedKey  String?
  suggestedName String
  reason        String?
  status        StoreProductTypeRequestStatus @default(PENDING)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  requestedBy   User                       @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById])
  @@index([status])
  @@map("store_product_type_request")
}

model StoreChangeRequest {
  id               String                   @id @default(cuid())
  storeId          String
  requestedById    String
  status           StoreChangeRequestStatus @default(PENDING)
  changes          Json
  comment          String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  store            Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requestedBy      User                     @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy       User?                    @relation("StoreChangeRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([requestedById])
  @@index([status])
  @@map("store_change_request")
}

model Order {
  id                   String                @id @default(cuid())
  storeId              String
  userId               String
  humanReadableId      String                @unique
  orderDate            DateTime
  expectedDeliveryFrom DateTime?
  expectedDeliveryTo   DateTime?
  currencyCode         String
  exchangeRate         Decimal?              @db.Decimal(18, 8)
  // Set true when the user changes their base currency, for every order whose currencyCode
  // differs from the new base — its stored exchangeRate is now stale and must be reconciled.
  // Cleared when the rate is (re)entered: on create, on edit, and on bulk FX reconciliation.
  needsExchangeRateUpdate Boolean            @default(false)
  totalCost            Int
  // Denormalized payment cache kept transactionally in sync by the payment/total mutations.
  // Payments stay the source of truth (single-order views recompute from them); these fields
  // exist so the orders list can filter by payment state and sort by paid ratio entirely in
  // SQL, instead of fetching every order to derive the percentage in memory. `paymentPercent`
  // is the same floor(paid/total*100) value the UI shows, so filter/sort/display never diverge.
  paidAmountMinor      Int                   @default(0)
  paymentPercent       Int                   @default(0)
  note                 String?
  status               OrderStatus           @default(OPEN)
  cancellationReason   String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                OrderItem[]
  payments             OrderPayment[]
  history              OrderHistory[]

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@index([userId, orderDate])
  @@index([userId, status])
  @@index([userId, paymentPercent])
  @@map("order")
}

model OrderItem {
  id                String                 @id @default(cuid())
  orderId           String
  userId            String
  name              String
  quantity          Int                    @default(1)
  unitPrice         Int?
  productTypeKey    String?
  position          Int
  deliveryState     OrderItemDeliveryState @default(NONE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType       StoreProductType?      @relation(fields: [productTypeKey], references: [key], onDelete: Restrict)
  deliveryItems     DeliveryOrderItem[]

  @@unique([orderId, position])
  @@index([orderId])
  @@index([userId])
  @@index([userId, deliveryState])
  @@map("order_item")
}

model OrderPayment {
  id          String   @id @default(cuid())
  orderId     String
  userId      String
  amount      Int
  paymentDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@map("order_payment")
}

model OrderHistory {
  id        String                @id @default(cuid())
  orderId   String
  userId    String
  eventType OrderHistoryEventType
  metadata  Json                  @default("{}")
  createdAt DateTime              @default(now())
  order     Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_history")
}

model Delivery {
  id                  String              @id @default(cuid())
  humanReadableId     String              @unique
  storeId             String
  userId              String
  status              DeliveryStatus      @default(IN_TRANSIT)
  deliveryDate        DateTime
  expectedArrivalFrom DateTime?
  expectedArrivalTo   DateTime?
  receivedDate        DateTime?
  cost                Int
  currencyCode        String
  exchangeRate        Decimal?            @db.Decimal(18, 8)
  // Set true when the user changes their base currency, for every delivery whose currencyCode
  // differs from the new base — its stored exchangeRate is now stale and must be reconciled.
  // Cleared when the delivery is edited (the collector reaffirms cost/currency/rate on save).
  needsExchangeRateUpdate Boolean         @default(false)
  note                String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  store               Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems          DeliveryOrderItem[]

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@index([userId, deliveryDate])
  @@map("delivery")
}

model DeliveryOrderItem {
  deliveryId  String
  orderItemId String
  createdAt   DateTime  @default(now())
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@id([deliveryId, orderItemId])
  @@index([orderItemId])
  @@map("delivery_order_item")
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

model NotificationDelivery {
  id          String                  @id @default(cuid())
  userId      String
  type        NotificationType
  subjectType NotificationSubjectType
  subjectId   String
  dueDate     DateTime
  sentAt      DateTime                @default(now())
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, subjectId, dueDate])
  @@index([userId])
  @@map("notification_delivery")
}

model NotificationPreference {
  userId                String   @id
  paymentDueEnabled     Boolean  @default(true)
  arrivalDueEnabled     Boolean  @default(true)
  arrivalOverdueEnabled Boolean  @default(true)
  storeRejectedEnabled  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}
