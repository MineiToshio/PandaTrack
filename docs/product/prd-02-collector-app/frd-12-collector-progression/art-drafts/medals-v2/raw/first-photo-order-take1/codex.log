+from collections import deque
+from pathlib import Path
+
+from PIL import Image
+
+
+SOURCE = Path("/Users/sergio/.codex/generated_images/01a03e36-1986-7df3-ae55-6d36c17ddfbb/exec-ca406db8-6846-4954-96fc-b9fe0460511a.png")
+OUTPUT = Path("first-photo-order.png")
+CANVAS_SIZE = 1024
+ART_SIZE = 870
+KEY = (255, 0, 255)
+TRANSPARENT_DISTANCE = 12
+OPAQUE_DISTANCE = 96
+
+
+def alpha_bbox(image: Image.Image, threshold: int = 16) -> tuple[int, int, int, int]:
+    alpha = image.getchannel("A")
+    mask = alpha.point(lambda value: 255 if value > threshold else 0)
+    bbox = mask.getbbox()
+    if bbox is None:
+        raise RuntimeError("Generated artwork has no visible pixels")
+    return bbox
+
+
+def composite_on_key(image: Image.Image) -> Image.Image:
+    keyed = Image.new("RGBA", image.size, (*KEY, 255))
+    keyed.alpha_composite(image)
+    return keyed.convert("RGB")
+
+
+def color_distance(pixel: tuple[int, int, int]) -> int:
+    return max(abs(pixel[index] - KEY[index]) for index in range(3))
+
+
+def is_key_candidate(pixel: tuple[int, int, int]) -> bool:
+    red, green, blue = pixel
+    distance = color_distance(pixel)
+    magenta_dominance = min(red, blue) - green
+    return distance < OPAQUE_DISTANCE and magenta_dominance > 24
+
+
+def border_connected_matte(image: Image.Image) -> Image.Image:
+    width, height = image.size
+    pixels = image.load()
+    connected = bytearray(width * height)
+    queue: deque[tuple[int, int]] = deque()
+
+    def seed(x: int, y: int) -> None:
+        index = y * width + x
+        if not connected[index] and is_key_candidate(pixels[x, y]):
+            connected[index] = 1
+            queue.append((x, y))
+
+    for x in range(width):
+        seed(x, 0)
+        seed(x, height - 1)
+    for y in range(height):
+        seed(0, y)
+        seed(width - 1, y)
+
+    while queue:
+        x, y = queue.popleft()
+        if x > 0:
+            seed(x - 1, y)
+        if x + 1 < width:
+            seed(x + 1, y)
+        if y > 0:
+            seed(x, y - 1)
+        if y + 1 < height:
+            seed(x, y + 1)
+
+    output = image.convert("RGBA")
+    out_pixels = output.load()
+    span = OPAQUE_DISTANCE - TRANSPARENT_DISTANCE
+    for y in range(height):
+        for x in range(width):
+            if not connected[y * width + x]:
+                out_pixels[x, y] = (*pixels[x, y], 255)
+                continue
+            distance = color_distance(pixels[x, y])
+            if distance <= TRANSPARENT_DISTANCE:
+                alpha = 0
+            else:
+                ratio = min(1.0, (distance - TRANSPARENT_DISTANCE) / span)
+                smooth = ratio * ratio * (3.0 - 2.0 * ratio)
+                alpha = round(255 * smooth)
+            if alpha == 0:
+                out_pixels[x, y] = (0, 0, 0, 0)
+            else:
+                red, green, blue = pixels[x, y]
+                anchor = green
+                cleaned = (min(red, anchor), green, min(blue, anchor))
+                out_pixels[x, y] = (*cleaned, alpha)
+    return output
+
+
+source = Image.open(SOURCE).convert("RGBA")
+cropped = source.crop(alpha_bbox(source))
+cropped.thumbnail((ART_SIZE, ART_SIZE), Image.Resampling.LANCZOS)
+
+transparent_canvas = Image.new("RGBA", (CANVAS_SIZE, CANVAS_SIZE), (0, 0, 0, 0))
+offset = ((CANVAS_SIZE - cropped.width) // 2, (CANVAS_SIZE - cropped.height) // 2)
+transparent_canvas.alpha_composite(cropped, offset)
+
+keyed_canvas = composite_on_key(transparent_canvas)
+final = border_connected_matte(keyed_canvas)
+final.save(OUTPUT, format="PNG", optimize=True)

