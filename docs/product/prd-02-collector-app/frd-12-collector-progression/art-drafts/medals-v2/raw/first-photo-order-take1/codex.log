+        seed(x, height - 1)
+    for y in range(height):
+        seed(0, y)
+        seed(width - 1, y)
+
+    while queue:
+        x, y = queue.popleft()
+        if x > 0:
+            seed(x - 1, y)
+        if x + 1 < width:
+            seed(x + 1, y)
+        if y > 0:
+            seed(x, y - 1)
+        if y + 1 < height:
+            seed(x, y + 1)
+
+    output = image.convert("RGBA")
+    out_pixels = output.load()
+    span = OPAQUE_DISTANCE - TRANSPARENT_DISTANCE
+    for y in range(height):
+        for x in range(width):
+            if not connected[y * width + x]:
+                out_pixels[x, y] = (*pixels[x, y], 255)
