+OUTPUT = Path("first-photo-order.png")
+CANVAS_SIZE = 1024
+ART_SIZE = 870
+KEY = (255, 0, 255)
+TRANSPARENT_DISTANCE = 12
+OPAQUE_DISTANCE = 96
+
+
+def alpha_bbox(image: Image.Image, threshold: int = 16) -> tuple[int, int, int, int]:
+    alpha = image.getchannel("A")
+    mask = alpha.point(lambda value: 255 if value > threshold else 0)
+    bbox = mask.getbbox()
+    if bbox is None:
+        raise RuntimeError("Generated artwork has no visible pixels")
+    return bbox
+
+
+def composite_on_key(image: Image.Image) -> Image.Image:
+    keyed = Image.new("RGBA", image.size, (*KEY, 255))
+    keyed.alpha_composite(image)
+    return keyed.convert("RGB")
+
+
+def color_distance(pixel: tuple[int, int, int]) -> int:
+    return max(abs(pixel[index] - KEY[index]) for index in range(3))
+
+
+def is_key_candidate(pixel: tuple[int, int, int]) -> bool:
+    red, green, blue = pixel
+    distance = color_distance(pixel)
+    magenta_dominance = min(red, blue) - green
+    return distance < OPAQUE_DISTANCE and magenta_dominance > 24
+
+
+def border_connected_matte(image: Image.Image) -> Image.Image:
+    width, height = image.size
+    pixels = image.load()
+    connected = bytearray(width * height)
