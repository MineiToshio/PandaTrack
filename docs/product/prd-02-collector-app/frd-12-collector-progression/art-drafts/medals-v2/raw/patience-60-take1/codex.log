from collections import deque
from PIL import Image

src = Image.open('patience-60-source.png').convert('RGBA')
alpha = src.getchannel('A')
mask = alpha.point(lambda v: 255 if v > 8 else 0)
bbox = mask.getbbox()
if bbox is None:
    raise SystemExit('No artwork found')
art = src.crop(bbox)
aw, ah = art.size
limit = 850
scale = min(limit / aw, limit / ah)
size = (max(1, round(aw * scale)), max(1, round(ah * scale)))
art = art.resize(size, Image.Resampling.LANCZOS)

# Normalize the generated nearly-opaque medal while retaining a soft antialiased edge.
r, g, b, a = art.split()
a = a.point(lambda v: 0 if v <= 3 else (255 if v >= 224 else round((v - 3) * 255 / 221)))
art = Image.merge('RGBA', (r, g, b, a))

canvas_size = 1024
x0 = (canvas_size - size[0]) // 2
y0 = (canvas_size - size[1]) // 2
transparent = Image.new('RGBA', (canvas_size, canvas_size), (0, 0, 0, 0))
transparent.alpha_composite(art, (x0, y0))

# Required chroma stage: flatten the isolated object over uniform pure green.
green = Image.new('RGBA', (canvas_size, canvas_size), (0, 255, 0, 255))
green.alpha_composite(transparent)
stage = green.convert('RGB')

# Remove only pure-green pixels connected to the four canvas borders.
pix = stage.load()
seen = bytearray(canvas_size * canvas_size)
q = deque()
def add(x, y):
    i = y * canvas_size + x
    if not seen[i] and pix[x, y] == (0, 255, 0):
        seen[i] = 1
        q.append((x, y))
for x in range(canvas_size):
    add(x, 0); add(x, canvas_size - 1)
for y in range(canvas_size):
    add(0, y); add(canvas_size - 1, y)
while q:
    x, y = q.popleft()
    if x: add(x - 1, y)
    if x + 1 < canvas_size: add(x + 1, y)
    if y: add(x, y - 1)
    if y + 1 < canvas_size: add(x, y + 1)

# Preserve the antialiased object alpha only outside the flood-filled exterior.
out = transparent.copy()
out_a = out.getchannel('A')
a_data = bytearray(out_a.tobytes())
for i, exterior in enumerate(seen):
    if exterior:
        a_data[i] = 0
out.putalpha(Image.frombytes('L', out.size, bytes(a_data)))
out.save('patience-60.png', 'PNG', optimize=True)
print('source bbox', bbox, 'resized art', size, 'offset', (x0, y0))
print('flood-filled exterior pixels', sum(seen))
