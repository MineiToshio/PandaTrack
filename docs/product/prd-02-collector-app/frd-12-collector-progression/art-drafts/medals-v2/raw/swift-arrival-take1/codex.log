from PIL import Image
import math
im=Image.open('swift-arrival.png').convert('RGBA')
a=im.getchannel('A')
box=a.getbbox()
pix=a.load()
transparent=sum(v==0 for v in a.getdata())
partial=sum(0<v<255 for v in a.getdata())
opaque=sum(v==255 for v in a.getdata())
coords=[(x,y) for y in range(im.height) for x in range(im.width) if pix[x,y]>0]
max_r=max(math.hypot(x-511.5,y-511.5) for x,y in coords)
magenta_inside=sum(1 for r,g,b,al in im.getdata() if al and r>230 and b>230 and g<40)
print('bbox',box,'alpha_extrema',a.getextrema(),'transparent',transparent,'partial',partial,'opaque',opaque)
print('max_radius',round(max_r,2),'diameter_pct',round(2*max_r/1024*100,2))
print('visible_near_magenta_pixels',magenta_inside)
print('corners',[im.getpixel(p) for p in [(0,0),(1023,0),(0,1023),(1023,1023)]])
