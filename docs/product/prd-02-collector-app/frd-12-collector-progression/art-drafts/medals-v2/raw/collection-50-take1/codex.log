from PIL import Image
from math import hypot
p='collection-50.png'
im=Image.open(p)
a=im.getchannel('A')
box=a.getbbox()
px=a.load()
pts=[(x,y) for y in range(im.height) for x in range(im.width) if px[x,y]>0]
maxr=max(hypot(x-511.5,y-511.5) for x,y in pts)
opaque=sum(1 for x,y in pts if px[x,y]==255)
partial=len(pts)-opaque
