+import math
+from pathlib import Path
+
+from PIL import Image, ImageDraw
+
+
+SOURCE = Path("/Users/sergio/.codex/generated_images/01a03c6d-3a9f-7b41-928e-8ba6eb7bbbbd/exec-eb39bafa-1b6b-4e75-a2d4-cba94b428969.png")
+OUTPUT = Path("/Users/Shared/Proyectos/pandatrack/art-drafts/medals-v2/raw/first-arrival-take1/first-arrival.png")
+CANVAS_SIZE = 1024
+MEDAL_SIZE = 870
+TRANSPARENT_DISTANCE = 12.0
+OPAQUE_DISTANCE = 150.0
+
+
+def remove_border_connected_magenta(image: Image.Image) -> Image.Image:
+    rgba = image.convert("RGBA")
+    rgb = rgba.convert("RGB")
+    width, height = rgb.size
+    sentinel = (1, 2, 3)
+
+    # Each seed lies on a different canvas border. Flood fill is performed on a
+    # copy, so no same-colour pixels isolated inside the artwork can be reached.
+    seeds = ((0, height // 2), (width - 1, height // 2), (width // 2, 0), (width // 2, height - 1))
+    connected = bytearray(width * height)
+    for seed in seeds:
+        border_fill = rgb.copy()
+        ImageDraw.floodfill(border_fill, seed, sentinel, thresh=int(OPAQUE_DISTANCE))
+        fill_pixels = border_fill.load()
+        for y in range(height):
+            row = y * width
+            for x in range(width):
+                if fill_pixels[x, y] == sentinel:
+                    connected[row + x] = 1
+
+    original_pixels = rgba.load()
+    for y in range(height):
+        for x in range(width):
+            if not connected[y * width + x]:
+                continue
+            red, green, blue, _ = original_pixels[x, y]
+            distance = math.sqrt((red - 255) ** 2 + green**2 + (blue - 255) ** 2)
+            alpha = round(
+                max(0.0, min(1.0, (distance - TRANSPARENT_DISTANCE) / (OPAQUE_DISTANCE - TRANSPARENT_DISTANCE)))
+                * 255
+            )
+            original_pixels[x, y] = (red, green, blue, alpha)
+    return rgba
+
+
+def main() -> None:
+    keyed = remove_border_connected_magenta(Image.open(SOURCE))
+    alpha = keyed.getchannel("A")
+    bbox = alpha.getbbox()
+    if bbox is None:
+        raise RuntimeError("No opaque artwork remained after chroma-key removal")
+
+    medal = keyed.crop(bbox)
+    medal.thumbnail((MEDAL_SIZE, MEDAL_SIZE), Image.Resampling.LANCZOS)
+    canvas = Image.new("RGBA", (CANVAS_SIZE, CANVAS_SIZE), (0, 0, 0, 0))
+    offset = ((CANVAS_SIZE - medal.width) // 2, (CANVAS_SIZE - medal.height) // 2)
+    canvas.alpha_composite(medal, offset)
+    canvas.save(OUTPUT, format="PNG", optimize=True)
+
+
+if __name__ == "__main__":
+    main()

