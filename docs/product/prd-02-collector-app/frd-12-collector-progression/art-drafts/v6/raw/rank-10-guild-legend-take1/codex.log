{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"magick ./guild-legend-source.png -trim +repage -resize '922x922\"'!'\"' -gravity center -background none -extent 1024x1024 -channel A -threshold 50% +channel ./guild-legend.png\npython - <<'PY'\nfrom PIL import Image\nfrom collections import deque\np='guild-legend.png'\nim=Image.open(p).convert('RGBA')\nw,h=im.size\npx=im.load()\nfg=[[px[x,y][3]>0 for x in range(w)] for y in range(h)]\n# Foreground components, 8-connected.\nseen=set(); comps=[]\nfor y in range(h):\n    for x in range(w):\n        if fg[y][x] and (x,y) not in seen:\n            q=[(x,y)]; seen.add((x,y)); n=0\n            while q:\n                a,b=q.pop(); n+=1\n                for db in (-1,0,1):\n                    for da in (-1,0,1):\n                        if da==db==0: continue\n                        c,d=a+da,b+db\n                        if 0<=c<w and 0<=d<h and fg[d][c] and (c,d) not in seen:\n                            seen.add((c,d)); q.append((c,d))\n            comps.append(n)\n# Background reachable from borders, 4-connected; remaining transparent pixels are enclosed holes.\nvis=set(); q=deque()\nfor x in range(w):\n    for y in (0,h-1):\n        if not fg[y][x] and (x,y) not in vis: vis.add((x,y)); q.append((x,y))\nfor y in range(h):\n    for x in (0,w-1):\n        if not fg[y][x] and (x,y) not in vis: vis.add((x,y)); q.append((x,y))\nwhile q:\n    x,y=q.popleft()\n    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n        a,b=x+dx,y+dy\n        if 0<=a<w and 0<=b<h and not fg[b][a] and (a,b) not in vis:\n            vis.add((a,b)); q.append((a,b))\nholes=sum(1 for y in range(h) for x in range(w) if not fg[y][x] and (x,y) not in vis)\nopaque_green=sum(1 for y in range(h) for x in range(w) if px[x,y][3] and px[x,y][1]>240 and px[x,y][0]<20 and px[x,y][2]<20)\npartials=sum(1 for y in range(h) for x in range(w) if 0<px[x,y][3]<255)\ncoords=[(x,y) for y in range(h) for x in range(w) if fg[y][x]]\nxs=[c[0] for c in coords]; ys=[c[1] for c in coords]\ninterval_rows=[]\nfor y in range(h):\n    intervals=0; inside=False\n    for x in range(w):\n        if fg[y][x] and not inside: intervals+=1; inside=True\n        elif not fg[y][x]: inside=False\n    if intervals>1: interval_rows.append((y,intervals))\nprint(f'size={w}x{h} mode={im.mode}')\nprint(f'bbox={min(xs)},{min(ys)}..{max(xs)},{max(ys)} span={max(xs)-min(xs)+1}x{max(ys)-min(ys)+1}')\nprint(f'alpha_partials={partials} corners={[px[0,0][3],px[w-1,0][3],px[0,h-1][3],px[w-1,h-1][3]]}')\nprint(f'foreground_components={len(comps)} sizes={sorted(comps,reverse=True)[:5]}')\nprint(f'enclosed_transparent_pixels={holes}')\nprint(f'opaque_pure_green_pixels={opaque_green}')\nprint(f'rows_with_multiple_foreground_intervals={len(interval_rows)} max_intervals={max((v for _,v in interval_rows),default=1)} sample={interval_rows[:12]}')\nPY\nfile ./guild-legend.png\nmagick identify ./guild-legend.png\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
