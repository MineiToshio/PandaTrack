{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom PIL import Image\nfrom collections import deque\nsrc = Image.open('guild-legend-chroma.png').convert('RGBA')\nw,h = src.size\npix = src.load()\n\ndef is_key(r,g,b,a):\n    return a > 0 and g >= 105 and g-r >= 42 and g-b >= 42 and g >= int(max(r,b)*1.22)\n\noutside = bytearray(w*h)\nq = deque()\ndef seed(x,y):\n    i=y*w+x\n    if not outside[i] and is_key(*pix[x,y]):\n        outside[i]=1; q.append((x,y))\nfor x in range(w):\n    seed(x,0); seed(x,h-1)\nfor y in range(h):\n    seed(0,y); seed(w-1,y)\nwhile q:\n    x,y=q.popleft()\n    for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\n        if 0<=nx<w and 0<=ny<h:\n            i=ny*w+nx\n            if not outside[i] and is_key(*pix[nx,ny]):\n                outside[i]=1; q.append((nx,ny))\n\n# Only the edge-connected chroma region becomes transparent. No global match.\nfor y in range(h):\n    for x in range(w):\n        if outside[y*w+x]:\n            pix[x,y]=(0,0,0,0)\n\n# Downsample to the exact requested canvas. Transparent RGB is neutralized first.\nfinal = src.resize((1024,1024), Image.Resampling.LANCZOS)\nfinal.save('guild-legend.png', optimize=True)\nprint(f'border-connected chroma pixels removed: {sum(outside)}')\nPY\nsips -g pixelWidth -g pixelHeight -g hasAlpha ./guild-legend.png\nfile ./guild-legend.png\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
