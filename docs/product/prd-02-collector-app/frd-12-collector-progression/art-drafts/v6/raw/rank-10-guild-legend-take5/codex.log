{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\nfrom PIL import Image\nfrom collections import deque\np='guild-legend-source.png'\nim=Image.open(p).convert('RGBA')\nw,h=im.size\npx=im.load()\n# transparent-mask components; any component not touching border is an enclosed alpha hole\nseen=bytearray(w*h)\nholes=[]\nborder_components=0\nfor y in range(h):\n  for x in range(w):\n    i=y*w+x\n    if seen[i] or px[x,y][3] \"'!= 0: continue\n    q=[(x,y)]; seen[i]=1; n=0; border=False\n    for qx,qy in q:\n      n+=1\n      if qx==0 or qy==0 or qx==w-1 or qy==h-1: border=True\n      for nx,ny in ((qx-1,qy),(qx+1,qy),(qx,qy-1),(qx,qy+1)):\n        if 0<=nx<w and 0<=ny<h:\n          ni=ny*w+nx\n          if not seen[ni] and px[nx,ny][3]==0:\n            seen[ni]=1; q.append((nx,ny))\n    if border: border_components+=1\n    else: holes.append(n)\n# opaque support components at alpha > 16\nseen=bytearray(w*h); comps=[]\nfor y in range(h):\n  for x in range(w):\n    i=y*w+x\n    if seen[i] or px[x,y][3] <= 16: continue\n    q=[(x,y)]; seen[i]=1; n=0\n    for qx,qy in q:\n      n+=1\n      for nx,ny in ((qx-1,qy),(qx+1,qy),(qx,qy-1),(qx,qy+1)):\n        if 0<=nx<w and 0<=ny<h:\n          ni=ny*w+nx\n          if not seen[ni] and px[nx,ny][3]>16:\n            seen[ni]=1; q.append((nx,ny))\n    comps.append(n)\n# pure-green count among nontransparent pixels\npure_green=sum(1 for r,g,b,a in im.getdata() if a and r==0 and g==255 and b==0)\nalpha0=sum(1 for *_,a in im.getdata() if a==0)\nalpha255=sum(1 for *_,a in im.getdata() if a==255)\nprint({'\"'size':(w,h),'transparent_px':alpha0,'opaque_px':alpha255,'transparent_border_components':border_components,'enclosed_transparent_holes':holes[:20],'foreground_components_alpha_gt_16':sorted(comps,reverse=True)[:10],'pure_green_nontransparent_px':pure_green})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
