{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom PIL import Image\nfrom collections import deque\nim=Image.open('guild-legend.png').convert('RGBA'); w,h=im.size; p=im.load()\n# components helper\n\ndef components(pred):\n    seen=bytearray(w*h); out=[]\n    for y in range(h):\n      for x in range(w):\n        i=y*w+x\n        if seen[i] or not pred(*p[x,y]): continue\n        q=[(x,y)]; seen[i]=1; n=0; border=False\n        for qx,qy in q:\n          n+=1; border |= qx in (0,w-1) or qy in (0,h-1)\n          for nx,ny in ((qx-1,qy),(qx+1,qy),(qx,qy-1),(qx,qy+1)):\n            if 0<=nx<w and 0<=ny<h:\n              ni=ny*w+nx\n              if not seen[ni] and pred(*p[nx,ny]): seen[ni]=1; q.append((nx,ny))\n        out.append((n,border))\n    return out\ntransparent=components(lambda r,g,b,a:a==0)\nforeground=components(lambda r,g,b,a:a>16)\npts=[(x,y) for y in range(h) for x in range(w) if p[x,y][3]>16]\nxs=[x for x,y in pts]; ys=[y for x,y in pts]\nbbox=(min(xs),min(ys),max(xs),max(ys)); bw=bbox[2]-bbox[0]+1; bh=bbox[3]-bbox[1]+1\nholes=[n for n,border in transparent if not border]\nfg=sorted((n for n,border in foreground),reverse=True)\ngreenish=sum(1 for r,g,b,a in im.getdata() if a>16 and g>max(r,b)*1.15 and g-max(r,b)>20)\nprint({'size':im.size,'mode':im.mode,'bbox':bbox,'coverage_pct':(round(100*bw/w,1),round(100*bh/h,1)),'transparent_components':len(transparent),'enclosed_alpha0_holes':holes,'foreground_components_gt16':fg[:8],'greenish_opaque_px':greenish,'corner_alpha':[p[0,0][3],p[w-1,0][3],p[0,h-1][3],p[w-1,h-1][3]]})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
