{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom PIL import Image\nim=Image.open('guild-legend.png').convert('RGBA');w,h=im.size;p=im.load();seen=bytearray(w*h);comps=[]\nfor y in range(h):\n for x in range(w):\n  i=y*w+x\n  if seen[i] or p[x,y][3]==0:continue\n  q=[(x,y)];seen[i]=1\n  for qx,qy in q:\n   for nx,ny in ((qx-1,qy),(qx+1,qy),(qx,qy-1),(qx,qy+1),(qx-1,qy-1),(qx+1,qy-1),(qx-1,qy+1),(qx+1,qy+1)):\n    if 0<=nx<w and 0<=ny<h:\n     ni=ny*w+nx\n     if not seen[ni] and p[nx,ny][3]>0:seen[ni]=1;q.append((nx,ny))\n  comps.append(q)\nmain=max(comps,key=len)\nfor comp in comps:\n if comp is main:continue\n for x,y in comp:p[x,y]=(0,0,0,0)\nim.save('guild-legend.png',optimize=True)\nprint('non-main alpha components removed',len(comps)-1,'pixels',sum(len(c) for c in comps if c is not main))\nPY\npython3 - <<'PY'\nfrom PIL import Image\nfrom collections import deque\nim=Image.open('guild-legend.png').convert('RGBA');w,h=im.size;p=im.load()\n# transparent topology\nseen=bytearray(w*h); t=[]\nfor y in range(h):\n for x in range(w):\n  i=y*w+x\n  if seen[i] or p[x,y][3]\"'!=0:continue\n  q=[(x,y)];seen[i]=1;border=False\n  for qx,qy in q:\n   border|=qx in(0,w-1) or qy in(0,h-1)\n   for nx,ny in ((qx-1,qy),(qx+1,qy),(qx,qy-1),(qx,qy+1)):\n    if 0<=nx<w and 0<=ny<h:\n     ni=ny*w+nx\n     if not seen[ni] and p[nx,ny][3]==0:seen[ni]=1;q.append((nx,ny))\n  t.append((len(q),border))\npts=[(x,y) for y in range(h) for x in range(w) if p[x,y][3]>16];xs=[x for x,y in pts];ys=[y for x,y in pts]\nprint({'\"'size':im.size,'mode':im.mode,'transparent_components':len(t),'enclosed_transparent_components':sum(1 for n,b in t if not b),'foreground_bbox':(min(xs),min(ys),max(xs),max(ys)),'corner_alpha':[p[0,0][3],p[w-1,0][3],p[0,h-1][3],p[w-1,h-1][3]]})\nPY\nshasum -a 256 ./guild-legend.png\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
