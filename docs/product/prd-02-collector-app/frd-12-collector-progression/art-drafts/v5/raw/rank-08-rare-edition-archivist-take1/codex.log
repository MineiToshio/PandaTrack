{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom PIL import Image\nfrom collections import deque\np='rare-edition-archivist.png'\nim=Image.open(p).convert('RGBA')\na=im.getchannel('A')\nw,h=im.size\npix=a.load()\nseen=bytearray(w*h)\nq=deque()\nfor x in range(w):\n    if pix[x,0]==0: q.append((x,0)); seen[x]=1\n    if pix[x,h-1]==0: q.append((x,h-1)); seen[(h-1)*w+x]=1\nfor y in range(h):\n    if pix[0,y]==0 and not seen[y*w]: q.append((0,y)); seen[y*w]=1\n    if pix[w-1,y]==0 and not seen[y*w+w-1]: q.append((w-1,y)); seen[y*w+w-1]=1\nwhile q:\n    x,y=q.popleft()\n    for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\n        if 0<=nx<w and 0<=ny<h:\n            i=ny*w+nx\n            if not seen[i] and pix[nx,ny]==0:\n                seen[i]=1; q.append((nx,ny))\nholes=sum(1 for y in range(h) for x in range(w) if pix[x,y]==0 and not seen[y*w+x])\nopaque=sum(1 for v in a.getdata() if v==255)\ntransparent=sum(1 for v in a.getdata() if v==0)\npartial=w*h-opaque-transparent\nprint(f'zero-alpha enclosed pixels={holes}')\nprint(f'opaque={opaque} transparent={transparent} partial-edge={partial}')\nPY\nls -l ./rare-edition-archivist.png\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
