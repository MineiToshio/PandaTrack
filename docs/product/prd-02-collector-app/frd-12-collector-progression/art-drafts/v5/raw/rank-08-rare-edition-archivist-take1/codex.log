{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom PIL import Image\nfrom collections import deque\npath='rare-edition-archivist.png'\nim=Image.open(path).convert('RGBA')\nw,h=im.size\np=im.load()\n# Pixels below the midpoint are candidate background. Only candidates connected\n# to a canvas border remain transparent, using 8-connectivity.\nexterior=bytearray(w*h)\nq=deque()\ndef seed(x,y):\n    i=y*w+x\n    if not exterior[i] and p[x,y][3] < 128:\n        exterior[i]=1\n        q.append((x,y))\nfor x in range(w):\n    seed(x,0); seed(x,h-1)\nfor y in range(h):\n    seed(0,y); seed(w-1,y)\nwhile q:\n    x,y=q.popleft()\n    for ny in range(max(0,y-1),min(h,y+2)):\n        for nx in range(max(0,x-1),min(w,x+2)):\n            i=ny*w+nx\n            if not exterior[i] and p[nx,ny][3] < 128:\n                exterior[i]=1\n                q.append((nx,ny))\n# Repair enclosed low-alpha defects with the nearest reliable painted pixel.\ndef nearest_rgb(x,y):\n    for radius in range(1,33):\n        x0=max(0,x-radius); x1=min(w-1,x+radius)\n        y0=max(0,y-radius); y1=min(h-1,y+radius)\n        for nx in range(x0,x1+1):\n            for ny in (y0,y1):\n                if p[nx,ny][3] >= 128: return p[nx,ny][:3]\n        for ny in range(y0+1,y1):\n            for nx in (x0,x1):\n                if p[nx,ny][3] >= 128: return p[nx,ny][:3]\n    return (0,0,0)\nrepairs=[]\nfor y in range(h):\n    for x in range(w):\n        i=y*w+x\n        if exterior[i]:\n            r,g,b,_=p[x,y]\n            p[x,y]=(r,g,b,0)\n        else:\n            r,g,b,a=p[x,y]\n            if a < 128:\n                r,g,b=nearest_rgb(x,y)\n                repairs.append((x,y))\n            p[x,y]=(r,g,b,255)\nim.save(path, format='PNG', optimize=True)\nprint(f'repaired enclosed pixels={len(repairs)}')\nPY\nidentify -format '%w x %h | channels=%[channels] | alpha-min=%[fx:minima.a] | alpha-max=%[fx:maxima.a]\\\\n' ./rare-edition-archivist.png\npython3 - <<'PY'\nfrom PIL import Image\nfrom collections import deque\nim=Image.open('rare-edition-archivist.png').convert('RGBA'); w,h=im.size; a=im.getchannel('A'); p=a.load()\nseen=bytearray(w*h); q=deque()\nfor x in range(w):\n for y in (0,h-1):\n  if p[x,y]==0 and not seen[y*w+x]: seen[y*w+x]=1; q.append((x,y))\nfor y in range(h):\n for x in (0,w-1):\n  if p[x,y]==0 and not seen[y*w+x]: seen[y*w+x]=1; q.append((x,y))\nwhile q:\n x,y=q.popleft()\n for ny in range(max(0,y-1),min(h,y+2)):\n  for nx in range(max(0,x-1),min(w,x+2)):\n   i=ny*w+nx\n   if not seen[i] and p[nx,ny]==0: seen[i]=1; q.append((nx,ny))\nholes=sum(1 for y in range(h) for x in range(w) if p[x,y]==0 and not seen[y*w+x])\nvals=set(a.getdata())\nprint(f'alpha-values={sorted(vals)} enclosed-transparent-pixels={holes}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
