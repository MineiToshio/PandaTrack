# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Postgres connection string (e.g. Neon, local). Required for Prisma and app data.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth (Better Auth)
# -----------------------------------------------------------------------------
# Secret for signing sessions and tokens. Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=
# Google OAuth: create credentials in Google Cloud Console for sign-in with Google.
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# Dev-only escape hatch: comma-separated list of extra origins Better Auth should trust
# (e.g. testing sign-in from a phone on the same LAN via http://192.168.x.x:3001).
# Leave empty in production.
BETTER_AUTH_EXTRA_ORIGINS=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# API key from Resend dashboard. Used for transactional emails (verification, password reset).
RESEND_API_KEY=
# Sender address shown in outgoing emails.
RESEND_FROM_EMAIL=hello@pandatrack.app

# -----------------------------------------------------------------------------
# Marketing audience sync (ConvertKit – Kit)
# -----------------------------------------------------------------------------
# API key from ConvertKit. Used to sync authenticated users as subscribers.
KIT_API_KEY=
# ConvertKit tag ID applied to authenticated app users (numeric ID).
KIT_TAG_ID_APP_USER=

# -----------------------------------------------------------------------------
# Monitoring (Sentry)
# -----------------------------------------------------------------------------
# Auth token for Sentry CLI (source maps, releases). From Sentry project settings.
SENTRY_AUTH_TOKEN=
# Sentry DSN (public project ingest URL, not a secret). From Sentry project settings > Client Keys.
# NEXT_PUBLIC_SENTRY_DSN is read by the client, server, and edge init; SENTRY_DSN can override it
# server-side only. When unset, the init falls back to the built-in project DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Analytics (PostHog)
# -----------------------------------------------------------------------------
# Project API key and host from PostHog. Used for product analytics and feature flags.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# -----------------------------------------------------------------------------
# App / site
# -----------------------------------------------------------------------------
# Public base URL of the app (links, OG, redirects) AND the origin Better Auth uses to
# build the Google OAuth redirect_uri (getPublicSiteUrl). No trailing slash.
# LOCAL DEV: this wins over NEXT_PUBLIC_APP_URL for auth, so on a non-default port set it
# to your local origin (e.g. http://localhost:7100) in .env.local — otherwise Google
# sign-in redirects back to the production domain. See docs/development/auth.md.
NEXT_PUBLIC_SITE_URL=https://pandatrack.app
# Explicit app origin override (getAppBaseUrl); used only when NEXT_PUBLIC_SITE_URL is unset
# (e.g. LAN binding). Falls back to VERCEL_URL, then localhost:3000. No trailing slash.
NEXT_PUBLIC_APP_URL=
# Comma-separated emails treated as admins (e.g. store creation defaults to APPROVED).
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Assets storage (S3-compatible object storage such as Cloudflare R2)
# -----------------------------------------------------------------------------
# Bucket name that stores public app assets.
ASSETS_STORAGE_BUCKET=
# S3-compatible API endpoint (for example an R2 endpoint URL).
ASSETS_STORAGE_ENDPOINT=
# Storage region or "auto" for providers that use a global region.
ASSETS_STORAGE_REGION=auto
# Access key used to upload and delete public assets.
ASSETS_STORAGE_ACCESS_KEY_ID=
# Secret key used to upload and delete public assets.
ASSETS_STORAGE_SECRET_ACCESS_KEY=
# Public base URL used to serve persisted assets. No trailing slash.
ASSETS_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Web Push (reminders)
# -----------------------------------------------------------------------------
# VAPID key pair for Web Push. Generate both with: npx web-push generate-vapid-keys
# The public key is exposed to the browser to subscribe; the private key signs sends
# and must never reach client code.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI or mailto used as the VAPID subject (e.g. mailto:hello@pandatrack.app).
VAPID_SUBJECT=
# Shared secret guarding the scheduled reminder dispatch route. Generate any high-entropy
# value, e.g.: openssl rand -hex 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# E2E tests (Playwright)
# -----------------------------------------------------------------------------
# Optional. Only required to run authenticated app shell E2E tests (burger menu, breadcrumbs).
# Use a real test user; tests perform sign-in and then assert on the app layout.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional. Port Playwright's dev server and baseURL use (defaults to 3000, Better Auth's
# default trusted origin). Set to run the suite off a port already used by another local
# project; add the matching `http://localhost:<port>` to BETTER_AUTH_EXTRA_ORIGINS above so
# Better Auth trusts it, or authenticated specs will skip themselves.
PLAYWRIGHT_PORT=
