# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.playwright-mcp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

generated/prisma

# Sentry Config File
.env.sentry-build-plugin
.env.local

# local MCP credentials
.mcp.json
.mcp.local.json

# claude local settings
.claude/settings.local.json

# Transient agent worktrees
.claude/worktrees/

# One-off local migration/maintenance scripts (never committed)
/scripts/local/

# E2E data guard baseline (regenerated on every run)
/.e2e-data-baseline.json

# Python virtualenvs used by local art-generation tooling under docs/ (never commit binaries)
**/art-drafts/**/.venv/
